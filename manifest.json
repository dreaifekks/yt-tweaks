{
  "manifest_version": 3,
  "name": "YT Tweaks",
  "version": "0.1.0",
  "description": "YouTube: videos per row that follow the window width, no Shorts, games or mixes among the videos, a word filter for the home page, and a quick playback speed control.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "YT Tweaks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "defaults.js",
        "settings.js",
        "filter.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "grid.js",
        "speed.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
